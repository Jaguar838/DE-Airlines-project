provider "google" {
  project = var.project_id
  region  = var.region
}

resource "google_storage_bucket" "data_lake" {
  name          = var.gcs_bucket_name
  location      = var.region
  storage_class = "STANDARD"

  uniform_bucket_level_access = true

  versioning {
    enabled = true
  }

  lifecycle_rule {
    action {
      type = "Delete"
    }
    condition {
      age = 30 // days
    }
  }

  force_destroy = true
}

resource "google_bigquery_dataset" "dwh" {
  dataset_id = var.bq_dataset_raw
  location   = var.region

  delete_contents_on_destroy = true
}

# 1. Create the service account
resource "google_service_account" "kestra_sa" {
  account_id   = "kestra-sa"
  display_name = "Service Account for Kestra ETL"
}

# 2. Assign permissions for the Bucket (write/delete objects)
resource "google_storage_bucket_iam_member" "kestra_storage_admin" {
  bucket = google_storage_bucket.data_lake.name
  role   = "roles/storage.objectAdmin"
  member = "serviceAccount:${google_service_account.kestra_sa.email}"
}

# 3. Assign permissions for BigQuery (data editing)
resource "google_bigquery_dataset_iam_member" "kestra_bq_editor" {
  dataset_id = google_bigquery_dataset.dwh.dataset_id
  role       = "roles/bigquery.dataEditor"
  member     = "serviceAccount:${google_service_account.kestra_sa.email}"
}

# 4. (Optional) Generate JSON key for Kestra
resource "google_service_account_key" "kestra_key" {
  service_account_id = google_service_account.kestra_sa.name
  public_key_type    = "TYPE_X509_PEM_FILE"
}

# Output the key to the console (caution: sensitive)
output "kestra_service_account_key" {
  value     = google_service_account_key.kestra_key.private_key
  sensitive = true
}

# terraform output -raw kestra_service_account_key | base64 --decode > kestra-key.json
